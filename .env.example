# ==============================================================================
# ReconPilot — Environment Configuration Reference Template
# Copy this file to .env and configure values for your environment.
# DO NOT COMMIT REAL CREDENTIALS, SECRETS, OR API KEYS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (REQUIRED: PostgreSQL Only)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
# Note: ReconPilot requires PostgreSQL 15+ with ACID transactional guarantees.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/reconpilot_dev

# Connection Pooling Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true

# ------------------------------------------------------------------------------
# 2. Application Environment & Host (REQUIRED)
# ------------------------------------------------------------------------------
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# ------------------------------------------------------------------------------
# 3. Security & Cryptographic Secrets (REQUIRED)
# In production, generate 64-character random hex strings:
# python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------------------------
APP_SECRET_KEY=dev_secret_key_change_in_production_min_32_bytes_long_12345
JWT_SECRET_KEY=dev_jwt_secret_key_change_in_production_min_32_bytes_long_12345
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Allowed CORS Origins (comma-separated string or JSON array)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 4. Frontend Environment Configuration (REQUIRED for Client)
# Points client API requests to the backend server
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# 5. Payment Gateway Integration (OPTIONAL in Dev)
# Razorpay API credentials for direct gateway ingestion sync
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 6. AI Root Cause Reasoner Configuration (OPTIONAL)
# When LLM_API_KEY is empty, AI_PROVIDER defaults to "mock".
# The deterministic mock provider produces schema-constrained, evidence-grounded
# investigation reports citing real dossier evidence without external network calls.
#
# Supported AI_PROVIDER values:
#   - mock   : Deterministic, local, rule-grounded mock analyzer (default)
#   - gemini : Google Gemini 1.5 Pro / Flash via official REST API
# ------------------------------------------------------------------------------
AI_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gemini-1.5-pro

# Reconciliation Tolerance & Policy Gate Thresholds
AMOUNT_TOLERANCE=1.00
AI_AUTO_CLASSIFY_THRESHOLD=0.90
AI_REVIEW_THRESHOLD=0.75
